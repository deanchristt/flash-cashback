{
  "info": {
    "name": "Flash Cashback",
    "_postman_id": "f1a5hcb0-0000-4000-a000-flashcashback1",
    "description": "Flash Cashback API — a 5% cashback campaign with a per-payment minimum (20,000 IDR), a per-user daily cap (50,000 IDR, Asia/Jakarta day), a global budget (10,000,000 IDR), and redemption.\n\n## Setup\n1. Start the backend: `docker compose up --build` (from the repo root).\n2. Either import the `Flash Cashback Local` environment, or just use this collection's built-in variables (`base_url`, `user_id`).\n3. Run requests top-to-bottom, or use the Collection Runner.\n\n## Notes\n- Authentication is out of scope; identity is sent via the `X-User-Id` header.\n- Every write auto-generates an `idempotency_key` (Postman `{{$guid}}`) in a pre-request script, so retries are safe. The 'Payment — idempotent retry' request deliberately reuses a fixed key to demonstrate that a duplicate never awards twice.\n- Amounts are whole IDR (no decimals).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "user_id", "value": "demo-user", "type": "string" },
    { "key": "payment_amount", "value": "50000", "type": "string" },
    { "key": "redeem_amount", "value": "1000", "type": "string" },
    { "key": "fixed_payment_key", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Ops",
      "item": [
        {
          "name": "Health (liveness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/healthz", "host": ["{{base_url}}"], "path": ["healthz"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ready (dependencies)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/readyz", "host": ["{{base_url}}"], "path": ["readyz"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Metrics (Prometheus)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/metrics", "host": ["{{base_url}}"], "path": ["metrics"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('exposes budget remaining gauge', () => pm.expect(pm.response.text()).to.include('cashback_budget_remaining_idr'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Campaign",
      "item": [
        {
          "name": "Get campaign status",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/v1/campaign", "host": ["{{base_url}}"], "path": ["v1", "campaign"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('has total & remaining', () => { pm.expect(b).to.have.property('total_budget'); pm.expect(b).to.have.property('remaining'); });",
                  "pm.collectionVariables.set('budget_remaining', b.remaining);",
                  "console.log('budget remaining:', b.remaining, '/', b.total_budget, 'active:', b.active);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Make payment (earns 5%)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh idempotency key per send — normal client behavior.",
                  "pm.collectionVariables.set('idem_key', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('awards floor(5%)', () => {",
                  "  const amt = Number(pm.collectionVariables.get('payment_amount'));",
                  "  const expected = amt < 20000 ? 0 : Math.floor(amt * 5 / 100);",
                  "  // may be capped by daily/budget; award never exceeds the 5% figure",
                  "  pm.expect(b.cashback_awarded).to.be.at.most(expected);",
                  "});",
                  "pm.test('first processing, not replayed', () => pm.expect(b.replayed).to.eql(false));",
                  "console.log('awarded', b.cashback_awarded, 'status', b.status, 'balance', b.balance);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{user_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{payment_amount}},\n  \"idempotency_key\": \"{{idem_key}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/payments", "host": ["{{base_url}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Payment — idempotent retry (send twice)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Reuse ONE fixed key across sends so a retry is detected.",
                  "if (!pm.collectionVariables.get('fixed_payment_key')) {",
                  "  pm.collectionVariables.set('fixed_payment_key', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "console.log('replayed:', b.replayed, '| awarded:', b.cashback_awarded);",
                  "pm.test('Send this request TWICE: the 2nd response has replayed:true and the same payment_id (no double award)', () => pm.expect(b).to.have.property('replayed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{user_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 30000,\n  \"idempotency_key\": \"{{fixed_payment_key}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/payments", "host": ["{{base_url}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Payment below minimum (no cashback)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('idem_key', pm.variables.replaceIn('{{$guid}}'));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('earns nothing below 20,000', () => pm.expect(b.cashback_awarded).to.eql(0));",
                  "pm.test('status no_cashback', () => pm.expect(b.status).to.eql('no_cashback'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{user_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000,\n  \"idempotency_key\": \"{{idem_key}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/payments", "host": ["{{base_url}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Payment fractional amount (rejected 400)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('idem_key', pm.variables.replaceIn('{{$guid}}'));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('rejects decimals', () => pm.expect(pm.response.json().error.code).to.eql('invalid_amount'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{user_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.5,\n  \"idempotency_key\": \"{{idem_key}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/payments", "host": ["{{base_url}}"], "path": ["v1", "payments"] }
          }
        },
        {
          "name": "Payment missing user header (401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('idem_key', pm.variables.replaceIn('{{$guid}}'));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('user_required', () => pm.expect(pm.response.json().error.code).to.eql('user_required'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000,\n  \"idempotency_key\": \"{{idem_key}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/payments", "host": ["{{base_url}}"], "path": ["v1", "payments"] }
          }
        }
      ]
    },
    {
      "name": "Cashback",
      "item": [
        {
          "name": "Get balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{user_id}}" }],
            "url": { "raw": "{{base_url}}/v1/cashback/balance", "host": ["{{base_url}}"], "path": ["v1", "cashback", "balance"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('current_balance', b.balance);",
                  "console.log('balance:', b.balance);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get history (ledger)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{user_id}}" }],
            "url": {
              "raw": "{{base_url}}/v1/cashback/history?limit=50",
              "host": ["{{base_url}}"],
              "path": ["v1", "cashback", "history"],
              "query": [{ "key": "limit", "value": "50" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns entries array', () => pm.expect(pm.response.json().entries).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Redeem cashback",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('idem_key', pm.variables.replaceIn('{{$guid}}'));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('redeemed the requested amount', () => pm.expect(b.redeemed).to.eql(Number(pm.collectionVariables.get('redeem_amount'))));",
                  "console.log('redeemed', b.redeemed, 'new balance', b.balance);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{user_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{redeem_amount}},\n  \"idempotency_key\": \"{{idem_key}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/cashback/redeem", "host": ["{{base_url}}"], "path": ["v1", "cashback", "redeem"] }
          }
        },
        {
          "name": "Redeem more than balance (422)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('idem_key', pm.variables.replaceIn('{{$guid}}'));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
                  "pm.test('insufficient_balance', () => pm.expect(pm.response.json().error.code).to.eql('insufficient_balance'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{user_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 999999999,\n  \"idempotency_key\": \"{{idem_key}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/v1/cashback/redeem", "host": ["{{base_url}}"], "path": ["v1", "cashback", "redeem"] }
          }
        }
      ]
    }
  ]
}
