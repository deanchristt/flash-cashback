# Copy to .env and adjust for local (non-Docker) runs.
APP_ENV=dev
PORT=8080

# Postgres — the source of truth for all money.
DATABASE_URL=postgres://cashback:cashback@localhost:5432/cashback?sslmode=disable

# Redis — cache / rate limiter only (never authoritative for money).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Campaign budget (IDR) used to seed a fresh database. 10,000,000 per the brief.
CAMPAIGN_TOTAL_BUDGET=10000000

# Write requests allowed per user per minute (0 disables rate limiting).
RATE_LIMIT_PER_MINUTE=60
